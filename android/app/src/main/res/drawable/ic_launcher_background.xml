<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标底板：和前景图形里的蓝色卡片用同一组渐变，
  这样卡片边缘和底板无缝，不会在图标外面看到一圈色差。
  取色自 mipmap-*/ic_launcher_foreground.png 卡片上下沿：#468EDC → #237EFC
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#468EDC"
        android:endColor="#237EFC"
        android:type="linear" />
</shape>
