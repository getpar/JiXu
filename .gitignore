.env
.env.local
.env.*.local

# ===== 系统文件 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== IDE / 编辑器文件 =====
.vscode/
.idea/
*.swp
*.swo
*~

# ===== 编译缓存 =====
.swc/
.sync-verify/

# ===== 临时文件 =====
*.log
*.tmp
.cache/

# ===== AI 工作区数据（本地笔记/记忆，无需上传） =====
.workbuddy-ai/

